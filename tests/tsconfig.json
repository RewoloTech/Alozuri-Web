{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["../apps/web/src/*"] }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "../playwright.config.ts",
    "../apps/api/test/**/*.ts",
    "../apps/api/test/**/*.mts"
  ]
}
