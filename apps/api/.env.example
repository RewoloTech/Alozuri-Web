PORT=8080
DEMO_MODE=true
GOOGLE_CLOUD_PROJECT=alozuri
# Optional server-side restriction: requires this UID AND the verified admin claim.
# This never grants a role. Empty denies all admins; remove for claim-only access.
ADMIN_OWNER_UID=
CORS_ORIGINS=http://localhost:3000
# Use Application Default Credentials locally and a least-privilege service account on Cloud Run.
# Leave payments disabled until matching Stripe keys and delivery infrastructure are configured.

# Dedicated random webhook URL token (at least 32 characters). Not the supplier SecretKey.
ESIM_WEBHOOK_TOKEN=

# Live read-only supplier catalogue. Keep credentials server-side.
ESIM_ACCESS_CODE=
ESIM_SECRET_KEY=
# Stripe environment: disabled, test or live. Match the key prefix to the mode.
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:3000
CATALOGUE_SYNC_AUDIENCE=
CATALOGUE_SYNC_SERVICE_ACCOUNT=

# Live delivery requires a scheduled authenticated worker.
FULFILLMENT_ENABLED=false
FULFILLMENT_WORKER_AUDIENCE=
FULFILLMENT_WORKER_SERVICE_ACCOUNT=

# Guest purchase retrieval and delivery emails (server-only).
ORDER_ACCESS_SECRET=
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Optional public test key for the real Stripe sandbox browser checks.
STRIPE_TEST_PUBLISHABLE_KEY=

# Optional migration maintenance: blocks NEW quotes/payments, keeps webhooks available.
CHECKOUT_PAUSED=false
# Live apply remains locked unless the exact project/version is explicitly approved.
PRICING_MIGRATION_APPROVED=

# Canonical USD pricing assumptions, basis points (100 = 1%). Versioned automatically.
# Confirm actual Stripe contract, settlement FX and tax treatment before release.
PRICING_DOMESTIC_FEE_BPS=150
PRICING_EEA_FEE_BPS=250
PRICING_INTERNATIONAL_FEE_BPS=315
PRICING_FX_FEE_BPS=200
# Conservative USD equivalent of fixed transaction fees, not GBP minor units.
PRICING_FIXED_FEE_USD_CENTS=30
PRICING_OTHER_COST_USD_CENTS=0
PRICING_MIN_CONTRIBUTION_USD_CENTS=50
PRICING_MIN_CONTRIBUTION_BPS=1500
