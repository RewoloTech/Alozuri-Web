NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Analytics is not initialized; reserved for a consent-aware integration.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe publishable key for the selected payment environment (public).
NEXT_PUBLIC_PAYMENT_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional search ownership tokens; omit until supplied by the search consoles.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional server-only upstream for the same-origin store transport.
# Defaults to NEXT_PUBLIC_API_URL; requires the Next.js server runtime.
ALOZURI_API_URL=

# Server-only. Set to cloudflare only behind Cloudflare with IP Geolocation enabled.
# Leave unset for USD initial suggestions; manual preferences continue to work.
CURRENCY_GEO_PROVIDER=
